# Copy to .env and adjust. The .env file is git-ignored.

APP_NAME="SJA Analytics API"
APP_ENV=dev

# Inside containers the SQLite file lives on the sja-data volume.
DATABASE_URL=sqlite:////app/data/sja.db

# Public domain served by the global Caddy (production only).
DOMAIN=sja-analytics.pawelzawada.dev

# Firebase credentials - not wired up yet, added when the sync lands.
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
