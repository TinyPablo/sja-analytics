# Snippet for the global Caddy on the server (/etc/caddy/Caddyfile).
# Append this block and reload:  sudo systemctl reload caddy
#
# Caddy owns the public domain and TLS. The stack's own nginx does the routing
# between the SPA and the API, so a single reverse_proxy is all Caddy needs -
# no separate handle for /api/*.
#
# Port 8300 is published by docker-compose.prod.yml on 127.0.0.1 only.
# Taken ports on this host: 3000, 3001, 5001, 8000, 8001, 8080, 8100, 8180,
# 8200, 8790.

sja-analytics.pawelzawada.dev {
	encode zstd gzip
	reverse_proxy localhost:8300
}
